<mxfile host="app.diagrams.net">
  <diagram id="dfd" name="Data Flow Diagram">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" page="1" pageWidth="900" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="admin" value="ADMIN / DEPARTMENT HEAD&#10;(external actor — the only system user)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fe" value="React Frontend&#10;(admin interface)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lb" value="Laravel Backend&#10;(auth · validation · business logic ·&#10;conflict detection · publish gate)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="210" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="PostgreSQL&#10;(central data store:&#10;scheduling data · schedules ·&#10;sessions · logs)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fa" value="FastAPI AI Engine&#10;→ OR-Tools CP-SAT&#10;(candidate schedule)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="360" y="370" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wf" value="Draft Schedule → Admin Review/Edit → Approved&#10;→ Publish Conflict Gate → Published Schedule&#10;→ Print/PDF → Faculty + Students" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="510" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dst" value="Faculty + Students&#10;(receive printed/PDF schedules —&#10;NOT system users)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="640" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="admin" target="fe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f1l" value="login / manage / generate /&#10;approve / publish / print" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="60" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="fe" target="lb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2l" value="HTTP/JSON + Bearer token" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="160" width="170" height="20" as="geometry" />
        </mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="lb" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3l" value="read/write scheduling data (ORM)" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="90" y="280" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="lb" target="fa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4l" value="generate request (section)" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="590" y="300" width="170" height="20" as="geometry" />
        </mxCell>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="fa" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5l" value="reads scheduling data&#10;(psycopg2)" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="470" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="fa" target="wf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f6l" value="result: OPTIMAL / PARTIAL / INFEASIBLE&#10;Laravel stores draft + generation log" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="465" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="wf" target="dst">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f7l" value="distribution" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="600" width="100" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
