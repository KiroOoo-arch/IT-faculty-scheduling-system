        </mxCell>
        <mxCell id="s0" value="1. Generate Schedule (click)" style="html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="370" y="100" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="2. POST /api/schedules/generate/{section}&#10;(Bearer token)" style="html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="145" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="3. archive old drafts for section" style="html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="380" y="200" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="4. POST /generate-schedule/{id}" style="html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="380" y="245" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="5. read scheduling data (section, subjects,&#10;qualified faculty, availability, loads, rooms,&#10;existing approved/published sessions)" style="html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="560" y="290" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="6. scheduling data" style="html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="620" y="355" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="7. solve (maximize scheduled sessions,&#10;8 constraint categories + preferred window)" style="html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="8. result: OPTIMAL / FEASIBLE / PARTIAL / INFEASIBLE" style="html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
