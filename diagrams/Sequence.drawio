          <mxGeometry x="150" y="590" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="12. display draft for review / edit" style="html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
