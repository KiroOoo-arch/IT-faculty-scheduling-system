<?xml version="1.0" encoding="UTF-8"?>
<!--
        This configuration is intended only for the two guarded selections against
    the verified disposable PostgreSQL database: the department-preflight test
    method and the FacultyWorkloadReportTest class. The launcher enforces the
    fixed database settings and performs read-only identity and privilege
    checks before PHPUnit starts. The target database must be dedicated to
    testing and contain no pre-existing application data. Both selections use
    RefreshDatabase and can execute migrate:fresh and DROP TABLE ... CASCADE,
    so never point this configuration at a source or production database.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.pgsql-guard.php"
         colors="true"
>
    <testsuites>
        <testsuite name="DepartmentPreflightTest, guarded PostgreSQL run">
            <file>tests/Feature/DepartmentPreflightTest.php</file>
        </testsuite>
        <testsuite name="FacultyWorkloadReportTest, guarded PostgreSQL run">
            <file>tests/Feature/FacultyWorkloadReportTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="scheduling_system_test_disposable_20261019" force="true"/>
        <env name="DB_USERNAME" value="its_test_runner" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
