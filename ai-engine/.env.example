# AI Engine environment variables.
#
# Local development template. Copy to `.env` (and never commit `.env` —
# the root `.gitignore` ignores `ai-engine/.env`).
#
# Values follow the Laravel backend `.env.example` defaults so the two
# applications point at the same database. Every value below is an example
# only; it must be replaced with real, service-owner-rotated credentials
# before anything is deployed or used in production.

# Database host — the PostgreSQL server the engine connects to.
DB_HOST=127.0.0.1

# Postgres port.
DB_PORT=5432

# Database name (defaults to scheduling_system in the app; must be the
# disposable test database when the guarded PHPUnit suite runs).
DB_DATABASE=scheduling_system

# Database role used by the application; it must hold the rights required by
# the guarded PostgreSQL test suite.
DB_USERNAME=its_app_runtime

# Database password. Use a strong, rotated password owned by an authorized
# database administrator.
DB_PASSWORD=

# Optional. FastAPI binds to this interface; leave 127.0.0.1 for a local
# development server. Change to 0.0.0.0 only when the service is meant to
# accept external connections.
HOST=127.0.0.1

# Optional. FastAPI port. Keep 8001 to match the documented engine port.
PORT=8001
